# Dependencies & build
node_modules/
dist/
*.tsbuildinfo

# Environment & secrets (never commit)
.env
.env.*
!.env.example

# Keys & credentials
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
*.crt
secrets/
credentials.json
service-account*.json

# CodeGraph (local index — recreated by `codegraph init` on each machine)
.codegraph/

# Local runtime / IDE
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# App-local data (may contain user data)
backend/data/store.json

# Docker / DB volumes
postgres_data/

# Optional local overrides (often contain secrets)
docker-compose.override.yml
docker-compose.local.yml

# ML — LoRA adapters (train on Colab → upload Hugging Face Hub, not Git)
ml/adapters/*
!ml/adapters/.gitkeep

# Python ML env & bytecode (incl. symlink to external venv on another partition)
.venv
ml/.venv
ml/.venv/
ml/.venv.light/
venv/
**/.venv/
**/.venv.light/
ml/**/__pycache__/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Training / export artifacts (large)
*.zip
*.tar.gz
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
ml/runs/
wandb/

# Hugging Face & torch cache (base Llama downloaded at inference)
.cache/
**/.cache/
huggingface/

# Local dataset exports / feedback dumps (may contain real user prompts)
ml/dataset/feedback_export.jsonl
ml/dataset/*.export.jsonl
