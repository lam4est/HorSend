# Copy to .env (never commit .env):
#   cp .env.example .env

# PostgreSQL (database app_db, port 5433 nếu dùng docker compose trong repo)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/app_db

PORT=3000

# Campaign Auto Scheduler — backend cron (NOT n8n)
# Wakes at exact send date/time; also re-checks every N seconds as safety net.
SCHEDULER_CRON_ENABLED=true
SCHEDULER_CRON_SECONDS=30

# Campaign Workflow — n8n → backend (set in n8n container env)
# Linux Docker: http://172.17.0.1:3000 or http://host.docker.internal:3000
# CAMPAIGN_API_URL=http://host.docker.internal:3000
# N8N_CAMPAIGN_SERVICE_KEY=change-me-in-production

# Chỉ khi chạy `docker compose up` trong repo này (khớp DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=app_db

# AI Workflow Builder — inference service (ml/inference, port 8001)
ML_INFERENCE_URL=http://127.0.0.1:8001
ML_INFERENCE_TIMEOUT_MS=60000
# Set true to skip inference service and use rule-based mock generator
ML_USE_MOCK=false

# Frontend production build (tùy chọn). Dev: Vite proxy /api → port 3000.
# VITE_API_URL=http://127.0.0.1:3000
